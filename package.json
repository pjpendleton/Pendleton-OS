{
  "name": "pendleton-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm schema:validate && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "schema:validate": "pnpm --filter @pendleton-os/contracts schema:validate",
    "test": "vitest run",
    "typecheck": "tsc6 -b"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "24.2.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0",
    "vitest": "3.2.4"
  }
}
